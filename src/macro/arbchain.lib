library (arbchain_lib) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1.0, pf);
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_voltage : 1.80;
  nom_temperature : 25;
  operating_conditions (nom_tt_025C_1v80) {
    process : 1.0;
    voltage : 1.80;
    temperature : 25;
    tree_type : balanced_tree;
  }
  default_operating_conditions : nom_tt_025C_1v80;
  default_max_transition : 1.0;
  default_max_fanout : 20;
  default_fanout_load : 1.0;
  default_input_pin_cap : 0.04;
  default_output_pin_cap : 0.06;

  cell (arbchain) {
    area : 1477.0944;
    cell_leakage_power : 5000.0;
    pg_pin (VPWR) { voltage_name : VPWR; pg_type : primary_power; }
    pg_pin (VGND) { voltage_name : VGND; pg_type : primary_ground; }
    pin (launch)    { direction : input;  capacitance : 0.03; max_capacitance : 0.5; }
    pin (arb_rst_n) { direction : input;  capacitance : 0.02; max_capacitance : 0.5; }
    pin (ch[0]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[1]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[2]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[3]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[4]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[5]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[6]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[7]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[8]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[9]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[10]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[11]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[12]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[13]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[14]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[15]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[16]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[17]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[18]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[19]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[20]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[21]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[22]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (ch[23]) { direction : input;  capacitance : 0.04; max_capacitance : 0.5; }
    pin (q)         { direction : output; max_capacitance : 0.5; }
  }
}
