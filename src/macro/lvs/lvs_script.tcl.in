# netgen LVS for the arbchain hard macro (template — @VARS@ substituted
# by run_lvs.sh).
#
# circuit1 = layout:  Magic extraction of src/macro/arbchain.gds
# circuit2 = schematic: PDK std-cell spice + generated reference netlist
#            (src/macro/lvs/gen_arbchain_ref.py, from arbchain.lef + RTL)
# NO -blackbox: the macro internals are exactly what we want to verify.

set circuit1 [readnet spice @OUT@/arbchain_lvs_norm.spice]
set circuit2 [readnet spice @PDK_SPICE@]
readnet spice @OUT@/arbchain_ref.spice $circuit2

lvs "$circuit1 arbchain" "$circuit2 arbchain" @SETUP@ @OUT@/lvs.netgen.rpt -json
puts "NETGEN_LVS_SCRIPT_DONE"
