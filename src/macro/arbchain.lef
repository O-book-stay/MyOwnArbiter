    RECT 13.200 77.280 14.950 77.980 ;
  END
 END VPWR
 PIN VGND
  DIRECTION INOUT ;
  USE GROUND ;
  PORT
   LAYER met1 ;
    RECT 12.000 78.000 17.280 78.670 ;
  END
 END VGND
 OBS
 LAYER li1 ;
  RECT 0.000 0.000 17.280 78.680 ;
 LAYER met1 ;
  RECT 0.600 0.000 12.000 78.000 ;
  RECT 0.000 0.000 4.700 73.840 ;
  RECT 6.100 0.000 12.000 73.840 ;
