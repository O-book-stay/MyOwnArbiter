# LEF abstract of the hand-drawn arbchain macro
# ports: geometry-derived; OBS: proven generator contract (see note)
VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO arbchain
 CLASS BLOCK ;
 ORIGIN 0 0 ;
 SIZE 17.280 BY 78.680 ;
 SYMMETRY X Y ;
